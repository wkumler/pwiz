#
# $Id$
#
#
# DuckDB (https://duckdb.org) is distributed under the MIT license; see LICENSE in this directory.
#
# The archives here contain the unmodified official prebuilt static libraries from
# https://github.com/duckdb/duckdb/releases (static-libs-<platform>.zip), repackaged
# into a directory named duckdb-<version>-<platform>. Jamroot extracts the archive for
# the current platform; ProteoWizard only uses DuckDB's C API (duckdb.h).
#
# To update DuckDB: add the new archives, then change .duckdb-version in Jamroot.jam.
#

path-constant DUCKDB_LINUX_PATH : duckdb-$(DUCKDB_VERSION)-linux-amd64 ;

# the prebuilt extension loader references every bundled extension, so all of these are needed
local duckdb-libs =
    duckdb_static
    duckdb_generated_extension_loader
    autocomplete_extension
    core_functions_extension
    icu_extension
    json_extension
    parquet_extension
    tpcds_extension
    tpch_extension
    duckdb_fastpforlib
    duckdb_fmt
    duckdb_fsst
    duckdb_hyperloglog
    duckdb_jemalloc
    duckdb_mbedtls
    duckdb_miniz
    duckdb_pg_query
    duckdb_re2
    duckdb_skiplistlib
    duckdb_utf8proc
    duckdb_yyjson
    duckdb_zstd
    ;

for local l in $(duckdb-libs)
{
    searched-lib $(l) : : <name>$(l) <toolset>gcc:<search>$(DUCKDB_LINUX_PATH) <link>static ;
}

alias duckdb
    : # sources
        $(duckdb-libs)
    : # requirements
    : # default-build
    : # usage-requirements
        <toolset>gcc:<include>$(DUCKDB_LINUX_PATH)
        <toolset>gcc:<linkflags>-ldl
    ;
